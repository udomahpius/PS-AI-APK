{
  "name": "profitsense-desktop",
  "version": "2.0.0",
  "private": true,
  "description": "ProfitSense AI desktop application",
  "author": "ProfitSense AI",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "mysql2": "^3.11.0",
    "pg": "^8.12.0",
    "mssql": "^11.0.1",
    "sql.js": "^1.11.0",
    "mongodb": "^6.8.0",
    "oracledb": "^6.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "vite": "^5.4.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "lucide-react": "^0.428.0"
  },
  "build": {
    "directories": {
      "output": "release"
    },
    "appId": "ai.profitsense.desktop",
    "productName": "ProfitSense AI",
    "files": [
      "dist/**",
      "main.cjs",
      "preload.cjs",
      "connectors.cjs"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ProfitSenseAI-Setup-${version}.exe"
    }
  }
}